<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lavender">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Purple header -->
        <FrameLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="10dp"
            android:background="@drawable/bg_header">

            <LinearLayout
                android:id="@+id/normalRow"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/menuBtn"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_btn_square"
                    android:src="@drawable/ic_menu"
                    android:tint="@color/white"
                    android:contentDescription="Menu" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitStart"
                    android:src="@drawable/yvibe_logo"
                    android:contentDescription="@string/app_name" />

                <ImageButton
                    android:id="@+id/searchBtn"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_btn_white"
                    android:src="@drawable/ic_search"
                    android:tint="@color/purple_dark"
                    android:contentDescription="Search" />

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp">
                    <ImageButton
                        android:id="@+id/bellBtn"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_btn_dark"
                        android:src="@drawable/ic_bell"
                        android:tint="@color/white"
                        android:contentDescription="Notifications" />
                    <View
                        android:id="@+id/bellDot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_dot" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/searchRow"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/searchBack"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_btn_square"
                    android:src="@drawable/ic_back"
                    android:tint="@color/white"
                    android:contentDescription="Back" />

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_search_pill"
                    android:hint="@string/search_hint"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_sub"
                    android:textSize="15sp"
                    android:singleLine="true"
                    android:imeOptions="actionSearch"
                    android:inputType="text" />

                <ImageButton
                    android:id="@+id/searchGo"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_btn_white"
                    android:src="@drawable/ic_search"
                    android:tint="@color/purple_dark"
                    android:contentDescription="Search" />
            </LinearLayout>
        </FrameLayout>

        <!-- Website, with rounded top corners overlapping the header -->
        <FrameLayout
            android:id="@+id/webContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="0dp"
            android:background="@color/lavender">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:progressTint="@color/purple"
                android:max="100"
                android:visibility="gone" />

            <!-- rounded top corners of the page (drawn over the web view) -->
            <ImageView
                android:id="@+id/cornerTl"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|start"
                android:src="@drawable/corner_tl" />
            <ImageView
                android:id="@+id/cornerTr"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:src="@drawable/corner_tr" />
        </FrameLayout>
    </LinearLayout>

    <!-- Floating bottom navigation -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:elevation="10dp"
        android:background="@drawable/bg_nav">
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/navHomeIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_home_f" />
            <TextView
                android:id="@+id/navHomeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Home"
                android:textSize="11sp"
                android:textColor="@color/ink_sub" />
            <View
                android:id="@+id/navHomeBar"
                android:layout_width="26dp"
                android:layout_height="3dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_bar"
                android:visibility="invisible" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navShorts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/navShortsIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_shorts" />
            <TextView
                android:id="@+id/navShortsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Shorts"
                android:textSize="11sp"
                android:textColor="@color/ink_sub" />
            <View
                android:id="@+id/navShortsBar"
                android:layout_width="26dp"
                android:layout_height="3dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_bar"
                android:visibility="invisible" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navSubs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/navSubsIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_subs" />
            <TextView
                android:id="@+id/navSubsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Subscriptions"
                android:textSize="11sp"
                android:textColor="@color/ink_sub" />
            <View
                android:id="@+id/navSubsBar"
                android:layout_width="26dp"
                android:layout_height="3dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_bar"
                android:visibility="invisible" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navYou"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/navYouIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_you" />
            <TextView
                android:id="@+id/navYouLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="You"
                android:textSize="11sp"
                android:textColor="@color/ink_sub" />
            <View
                android:id="@+id/navYouBar"
                android:layout_width="26dp"
                android:layout_height="3dp"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_bar"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
