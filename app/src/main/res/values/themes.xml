<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.YVIBE" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/lavender</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
    <!-- Launch theme: lavender + logo, swapped to Theme.YVIBE in onCreate -->
    <style name="Theme.YVIBE.Splash" parent="Theme.YVIBE">
        <item name="android:windowBackground">@drawable/splash_bg</item>
    </style>
</resources>
